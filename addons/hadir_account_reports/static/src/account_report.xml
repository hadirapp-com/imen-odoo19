<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="hadir_account_reports.AccountReport" owl="1">
        <div class="hpr-report">
            <t t-if="state.info">
                <AccountReportFilters
                    info="state.info"
                    onDateRange.bind="this.onDateRange"
                    onComparison.bind="this.onComparison"
                    onMonthlyMode.bind="this.onMonthlyMode"
                    onJournals.bind="this.onJournals"
                    onAllEntries.bind="this.onAllEntries"
                    onUnfoldAll.bind="this.onUnfoldAll"
                    onConsolidation.bind="this.onConsolidation"
                    onElimination.bind="this.onElimination"
                    onSwitchReport.bind="this.onSwitchReport"
                    onPrintPdf.bind="this.printPdf"
                    onExportXlsx.bind="this.exportXlsx"/>
                <div class="hpr-content">
                    <AccountReportTable
                        info="state.info"
                        onToggleLine.bind="this.onToggleLine"
                        onOpenLine.bind="this.onOpenLine"/>
                </div>
            </t>
            <div t-if="state.error" class="hpr-error alert alert-danger m-3" role="alert">
                <i class="fa fa-exclamation-triangle me-2"/>
                <t t-esc="state.error"/>
            </div>
            <div t-if="state.loading" class="hpr-loading">
                <div class="spinner-border text-primary" role="status"/>
            </div>
        </div>
    </t>

    <t t-name="hadir_account_reports.AccountReportFilters" owl="1">
        <div class="hpr-header">
            <Dropdown>
                <t t-set-slot="toggler">
                    <button class="hpr-report-name btn">
                        <t t-esc="props.info.report.name"/>
                        <i class="fa fa-caret-down ms-2 text-muted"/>
                    </button>
                </t>
                <DropdownItem t-foreach="props.info.reports_list" t-as="item" t-key="item.report_id"
                              onSelected="() => props.onSwitchReport(item)">
                    <i t-if="item.is_current" class="fa fa-check me-2"/>
                    <t t-esc="item.name"/>
                </DropdownItem>
            </Dropdown>

            <div class="hpr-header-filters">
                <!-- Date -->
                <Dropdown>
                    <t t-set-slot="toggler">
                        <button class="hpr-pill btn">
                            <i class="fa fa-calendar me-2 text-muted"/>
                            <t t-esc="dateShortLabel() || 'Date'"/>
                            <i class="fa fa-caret-down ms-2 text-muted"/>
                        </button>
                    </t>
                    <div class="hpr-dropdown-panel">
                        <button class="dropdown-item" t-on-click="() => this.applyPreset('month')">
                            This Month
                        </button>
                        <button class="dropdown-item" t-on-click="() => this.applyPreset('quarter')">
                            This Quarter
                        </button>
                        <button class="dropdown-item" t-on-click="() => this.applyPreset('year')">
                            This Year
                        </button>
                        <div class="dropdown-divider"/>
                        <div class="hpr-dropdown-section">
                            <div class="hpr-dropdown-title">Custom Range</div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <label class="small text-muted">From</label>
                                <input type="date" class="form-control form-control-sm" t-model="local.dateFrom"/>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <label class="small text-muted">To</label>
                                <input type="date" class="form-control form-control-sm" t-model="local.dateTo"/>
                            </div>
                            <button class="btn btn-primary btn-sm w-100"
                                    t-on-click="this.applyCustomRange">Apply</button>
                        </div>
                    </div>
                </Dropdown>

                <!-- Comparison -->
                <Dropdown t-if="filters.comparison and !options.balance_mode">
                    <t t-set-slot="toggler">
                        <button class="hpr-pill btn">
                            <i class="fa fa-hourglass-half me-2 text-muted"/>
                            Comparison
                            <t t-if="options.comparison.mode === 'previous_period'"> · Prev. Periods</t>
                            <t t-elif="options.comparison.mode === 'previous_year'"> · Prev. Years</t>
                            <i class="fa fa-caret-down ms-2 text-muted"/>
                        </button>
                    </t>
                    <div class="hpr-dropdown-panel">
                        <button class="dropdown-item d-flex align-items-center"
                                t-att-class="{active: options.comparison.mode === 'none'}"
                                t-on-click="() => this.setComparison('none')">
                            No Comparison
                        </button>
                        <div class="dropdown-divider"/>
                        <div class="hpr-dropdown-section">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="small flex-grow-1">Previous Periods</span>
                                <input type="number" min="1" max="12" class="form-control form-control-sm hpr-number-input"
                                       t-model="local.comparisonNumber"/>
                                <button class="btn btn-secondary btn-sm"
                                        t-on-click="() => this.setComparison('previous_period')">Apply</button>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="small flex-grow-1">Same Period Last Year</span>
                                <input type="number" min="1" max="12" class="form-control form-control-sm hpr-number-input"
                                       t-model="local.comparisonNumber"/>
                                <button class="btn btn-secondary btn-sm"
                                        t-on-click="() => this.setComparison('previous_year')">Apply</button>
                            </div>
                        </div>
                        <div class="dropdown-divider"/>
                        <label class="dropdown-item d-flex align-items-center gap-2">
                            <input type="checkbox"
                                   t-att-checked="options.monthly_mode"
                                   t-on-change="(ev) => props.onMonthlyMode(ev.target.checked)"/>
                            Monthly Columns
                        </label>
                    </div>
                </Dropdown>

                <!-- Journals -->
                <Dropdown t-if="filters.journals">
                    <t t-set-slot="toggler">
                        <button class="hpr-pill btn">
                            <i class="fa fa-book me-2 text-muted"/>
                            Journals
                            <t t-if="options.journals.length" t-esc="' (' + options.journals.length + ')'"/>
                            <i class="fa fa-caret-down ms-2 text-muted"/>
                        </button>
                    </t>
                    <div class="hpr-dropdown-panel hpr-dropdown-panel--scroll">
                        <button t-if="options.journals.length"
                                class="dropdown-item text-muted small"
                                t-on-click="() => props.onJournals([])">
                            <i class="fa fa-times me-2"/>Clear selection
                        </button>
                        <div t-if="options.journals.length" class="dropdown-divider"/>
                        <label t-foreach="props.info.journals" t-as="journal" t-key="journal.id"
                               class="dropdown-item d-flex align-items-center gap-2">
                            <input type="checkbox"
                                   t-att-checked="options.journals.includes(journal.id)"
                                   t-on-change="(ev) => this.onJournalToggle(journal, ev)"/>
                            <span class="badge text-bg-secondary" t-esc="journal.code"/>
                            <t t-esc="journal.name"/>
                        </label>
                    </div>
                </Dropdown>

                <!-- Options -->
                <Dropdown>
                    <t t-set-slot="toggler">
                        <button class="hpr-pill btn">
                            <i class="fa fa-gear me-2 text-muted"/>
                            Options
                            <i class="fa fa-caret-down ms-2 text-muted"/>
                        </button>
                    </t>
                    <div class="hpr-dropdown-panel">
                        <div class="hpr-dropdown-title">General</div>
                        <label t-if="filters.show_draft"
                               class="dropdown-item d-flex align-items-center gap-2">
                            <input type="checkbox"
                                   t-att-checked="options.all_entries"
                                   t-on-change="(ev) => props.onAllEntries(ev.target.checked)"/>
                            Draft Entries
                        </label>
                        <label t-if="filters.unfold_all"
                               class="dropdown-item d-flex align-items-center gap-2">
                            <input type="checkbox"
                                   t-att-checked="options.unfold_all"
                                   t-on-change="(ev) => props.onUnfoldAll(ev.target.checked)"/>
                            Unfold All
                        </label>
                        <t t-if="filters.consolidation and filters.consolidation.available">
                            <div class="dropdown-divider"/>
                            <div class="hpr-dropdown-title">Consolidation</div>
                            <label class="dropdown-item d-flex align-items-center gap-2">
                                <input type="checkbox"
                                       t-att-checked="options.hadir_consolidation"
                                       t-on-change="(ev) => props.onConsolidation(ev.target.checked)"/>
                                Konsolidasi Cabang
                            </label>
                            <label class="dropdown-item d-flex align-items-center gap-2 ps-4"
                                   t-att-class="{disabled: !options.hadir_consolidation}">
                                <input type="checkbox"
                                       t-att-checked="options.hadir_elimination"
                                       t-att-disabled="!options.hadir_consolidation"
                                       t-on-change="(ev) => props.onElimination(ev.target.checked)"/>
                                Eliminasi Antar-Cabang
                            </label>
                        </t>
                    </div>
                </Dropdown>

                <!-- Print / Export -->
                <div class="hpr-header-actions ms-auto">
                    <button class="hpr-pill btn" t-on-click="() => props.onPrintPdf()">
                        <i class="fa fa-print me-2 text-muted"/>
                        Print (PDF)
                    </button>
                    <button class="hpr-pill btn" t-on-click="() => props.onExportXlsx()">
                        <i class="fa fa-download me-2 text-muted"/>
                        Export (XLSX)
                    </button>
                </div>
            </div>
        </div>
    </t>

    <t t-name="hadir_account_reports.AccountReportTable" owl="1">
        <table class="hpr-table">
            <thead>
                <tr class="hpr-thead-periods">
                    <th class="hpr-thead-name hpr-thead-corner">
                        <span t-if="props.info.currency" class="text-muted small">in <t t-esc="props.info.currency"/></span>
                    </th>
                    <t t-foreach="headerGroups" t-as="group" t-key="group_index">
                        <th t-att-colspan="group.span" class="text-center hpr-period-label">
                            <t t-esc="group.label"/>
                        </th>
                    </t>
                </tr>
                <tr>
                    <th class="hpr-thead-name"/>
                    <t t-foreach="props.info.columns" t-as="column" t-key="column_index">
                        <th t-attf-class="text-end hpr-thead-col {{ column_index % colsPerPeriod() === 0 ? 'hpr-block-start' : '' }}">
                            <t t-esc="column.name"/>
                        </th>
                    </t>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="props.info.lines" t-as="line" t-key="line.id"
                    t-attf-class="{{ rowClass(line) }} {{ (line.foldable or line.action_id) ? 'hpr-row--clickable' : '' }}"
                    t-on-click="(ev) => this.onRowClick(line, ev)">
                    <td class="hpr-cell--name" t-attf-style="padding-left: {{ 8 + line.level * 20 }}px;">
                        <span t-if="line.foldable" class="hpr-fold-icon">
                            <i t-attf-class="fa fa-caret-{{ line.unfolded ? 'down' : 'right' }}"/>
                        </span>
                        <t t-esc="line.name"/>
                    </td>
                    <t t-foreach="line.cells" t-as="cell" t-key="cell_index">
                        <td t-attf-class="hpr-cell--amount {{ cell.classes }} {{ cell_index % colsPerPeriod() === 0 ? 'hpr-block-start' : '' }}">
                            <t t-esc="cell.plain !== undefined ? cell.plain : cell.formatted"/>
                        </td>
                    </t>
                </tr>
            </tbody>
        </table>
    </t>

</templates>
