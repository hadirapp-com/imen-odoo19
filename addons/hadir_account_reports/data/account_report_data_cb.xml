                    <record id="hpr_bb_root_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula">[('account_id', '!=', False), ('journal_id.type', '=', 'bank')]</field>
                        <field name="subformula">balance</field>
