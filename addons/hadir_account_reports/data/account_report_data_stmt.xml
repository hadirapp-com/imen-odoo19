<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================= -->
    <!-- CUSTOMER STATEMENT (dynamic): per-partner running balance      -->
    <!-- synthesized by AccountReport._hpr_get_partner_statement_table. -->
    <!-- ============================================================= -->
    <record id="hpr_customer_statement" model="account.report">
        <field name="name">Customer Statement</field>
        <field name="sequence">165</field>
        <field name="availability_condition">always</field>
        <field name="default_opening_date_filter">this_year</field>
        <field name="filter_date_range" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_show_draft" eval="True"/>
        <field name="filter_period_comparison" eval="False"/>
        <field name="filter_partner" eval="True"/>
        <field name="hpr_dynamic">partner_statement</field>
        <field name="column_ids">
            <record id="hpr_customer_statement_column_debit" model="account.report.column">
                <field name="name">Debit</field>
                <field name="expression_label">debit</field>
                <field name="sequence">1</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="hpr_customer_statement_column_credit" model="account.report.column">
                <field name="name">Credit</field>
                <field name="expression_label">credit</field>
                <field name="sequence">2</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="hpr_customer_statement_column_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
                <field name="sequence">3</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>
    </record>
</odoo>
