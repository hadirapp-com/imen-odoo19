<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================= -->
    <!-- GENERAL LEDGER                                                 -->
    <!-- ============================================================= -->
    <record id="hpr_general_ledger" model="account.report">
        <field name="name">General Ledger</field>
        <field name="sequence">130</field>
        <field name="availability_condition">always</field>
        <field name="default_opening_date_filter">this_year</field>
        <field name="load_more_limit">20</field>
        <field name="filter_date_range" eval="True"/>
        <field name="filter_unfold_all" eval="True"/>
        <field name="filter_show_draft" eval="True"/>
        <field name="filter_period_comparison" eval="True"/>
        <field name="filter_journals" eval="True"/>
        <field name="column_ids">
            <record id="hpr_gl_column_debit" model="account.report.column">
                <field name="name">Debit</field>
                <field name="expression_label">debit</field>
                <field name="sequence">1</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="hpr_gl_column_credit" model="account.report.column">
                <field name="name">Credit</field>
                <field name="expression_label">credit</field>
                <field name="sequence">2</field>
                <field name="figure_type">monetary</field>
            </record>
            <record id="hpr_gl_column_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
                <field name="sequence">3</field>
                <field name="figure_type">monetary</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="hpr_gl_initial" model="account.report.line">
                <field name="name">Initial Balance</field>
                <field name="code">total_hpr_gl_initial</field>
                <field name="hierarchy_level">0</field>
                <field name="sequence">5</field>
                <field name="hide_if_zero" eval="True"/>
                <field name="expression_ids">
                    <record id="hpr_gl_initial_debit" model="account.report.expression">
                        <field name="label">debit</field>
                        <field name="engine">domain</field>
                        <field name="formula">[('account_id', '!=', False)]</field>
                        <field name="subformula">debit</field>
                        <field name="date_scope">to_beginning_of_period</field>
                    </record>
                    <record id="hpr_gl_initial_credit" model="account.report.expression">
                        <field name="label">credit</field>
                        <field name="engine">domain</field>
                        <field name="formula">[('account_id', '!=', False)]</field>
                        <field name="subformula">credit</field>
                        <field name="date_scope">to_beginning_of_period</field>
                    </record>
                    <record id="hpr_gl_initial_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula">[('account_id', '!=', False)]</field>
                        <field name="subformula">balance</field>
                        <field name="date_scope">to_beginning_of_period</field>
                    </record>
                </field>
            </record>
            <record id="hpr_gl_root" model="account.report.line">
                <field name="name">Journal Entries</field>
                <field name="code">total_hpr_gl_root</field>
                <field name="hierarchy_level">0</field>
                <field name="sequence">10</field>
                <field name="groupby">account_id</field>
                <field name="foldable" eval="True"/>
                <field name="expression_ids">
                    <record id="hpr_gl_root_debit" model="account.report.expression">
                        <field name="label">debit</field>
                        <field name="engine">domain</field>
                        <field name="formula">[('account_id', '!=', False)]</field>
                        <field name="subformula">debit</field>
                        <field name="date_scope">strict_range</field>
                    </record>
                    <record id="hpr_gl_root_credit" model="account.report.expression">
                        <field name="label">credit</field>
                        <field name="engine">domain</field>
                        <field name="formula">[('account_id', '!=', False)]</field>
                        <field name="subformula">credit</field>
                        <field name="date_scope">strict_range</field>
                    </record>
                    <record id="hpr_gl_root_balance" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">domain</field>
                        <field name="formula">[('account_id', '!=', False)]</field>
                        <field name="subformula">balance</field>
                        <field name="date_scope">strict_range</field>
                    </record>
                </field>
            </record>
        </field>
    </record>

