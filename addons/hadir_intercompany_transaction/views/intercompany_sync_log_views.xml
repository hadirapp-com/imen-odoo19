<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_intercompany_sync_log_list" model="ir.ui.view">
            <field name="name">intercompany.sync.log.list</field>
            <field name="model">intercompany.sync.log</field>
            <field name="arch" type="xml">
                <list decoration-danger="result == 'failed'"
                      decoration-info="result == 'info'">
                    <field name="date"/>
                    <field name="source_company_id" optional="show"/>
                    <field name="target_company_id" optional="show"/>
                    <field name="operation"/>
                    <field name="document_type" optional="show"/>
                    <field name="source_doc_ref"/>
                    <field name="target_doc_ref"/>
                    <field name="result" widget="badge"
                           decoration-success="result == 'success'"
                           decoration-danger="result == 'failed'"
                           decoration-info="result == 'info'"/>
                    <field name="user_id" optional="hide" widget="many2one_avatar_user"/>
                    <field name="duration_ms" optional="hide"/>
                    <field name="error_message" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_intercompany_sync_log_search" model="ir.ui.view">
            <field name="name">intercompany.sync.log.search</field>
            <field name="model">intercompany.sync.log</field>
            <field name="arch" type="xml">
                <search>
                    <field name="source_doc_ref"/>
                    <field name="target_doc_ref"/>
                    <field name="transaction_id"/>
                    <field name="error_message"/>
                    <filter name="failed" string="Failed" domain="[('result', '=', 'failed')]"/>
                    <filter name="success" string="Success" domain="[('result', '=', 'success')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_result" string="Result" context="{'group_by': 'result'}"/>
                        <filter name="group_operation" string="Operation" context="{'group_by': 'operation'}"/>
                        <filter name="group_source" string="Buyer Company" context="{'group_by': 'source_company_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_intercompany_sync_log_form" model="ir.ui.view">
            <field name="name">intercompany.sync.log.form</field>
            <field name="model">intercompany.sync.log</field>
            <field name="arch" type="xml">
                <form create="false" edit="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="user_id"/>
                                <field name="transaction_id"/>
                                <field name="move_link_id"/>
                            </group>
                            <group>
                                <field name="source_company_id"/>
                                <field name="target_company_id"/>
                                <field name="document_type"/>
                                <field name="operation"/>
                                <field name="result"/>
                                <field name="duration_ms"/>
                                <field name="retry_count"/>
                            </group>
                        </group>
                        <group string="Documents">
                            <field name="source_doc_ref"/>
                            <field name="target_doc_ref"/>
                        </group>
                        <group string="Error" invisible="not error_message">
                            <field name="error_message"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_intercompany_sync_log" model="ir.actions.act_window">
            <field name="name">Sync Logs</field>
            <field name="res_model">intercompany.sync.log</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
