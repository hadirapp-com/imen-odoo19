<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_sale_order_form_intercompany" model="ir.ui.view">
            <field name="name">sale.order.form.intercompany</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_intercompany" type="object" class="oe_stat_button"
                            icon="fa-exchange"
                            groups="hadir_intercompany_transaction.group_intercompany_user"
                            invisible="not intercompany_transaction_id">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Intercompany</span>
                            <field name="intercompany_sync_state" widget="badge"
                                   decoration-info="intercompany_sync_state in ('draft', 'quotation_created', 'quotation_sent')"
                                   decoration-warning="intercompany_sync_state in ('so_confirmed', 'partially_invoiced')"
                                   decoration-success="intercompany_sync_state == 'fully_invoiced'"
                                   decoration-danger="intercompany_sync_state == 'error'"
                                   invisible="not intercompany_sync_state"/>
                        </div>
                    </button>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page name="intercompany" string="Intercompany"
                          groups="hadir_intercompany_transaction.group_intercompany_user"
                          invisible="not intercompany_transaction_id">
                        <group>
                            <field name="intercompany_transaction_id"/>
                            <field name="intercompany_source_ref" string="Source RFQ"/>
                            <field name="intercompany_sync_state" widget="badge"
                                   decoration-info="intercompany_sync_state in ('draft', 'quotation_created', 'quotation_sent')"
                                   decoration-warning="intercompany_sync_state in ('so_confirmed', 'partially_invoiced')"
                                   decoration-success="intercompany_sync_state == 'fully_invoiced'"
                                   decoration-danger="intercompany_sync_state == 'error'"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
