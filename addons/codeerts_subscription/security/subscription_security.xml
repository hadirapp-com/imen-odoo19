<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v19 access-privilege (groups point at a res.groups.privilege; the privilege
         carries the ir.module.category). v18 down-port: drop this record and set
         category_id directly on the groups. -->
    <record id="res_groups_privilege_subscription" model="res.groups.privilege">
        <field name="name">Subscriptions</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_subscription_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_subscription"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Access to view and manage subscriptions.</field>
    </record>

    <record id="group_subscription_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_subscription"/>
        <field name="implied_ids" eval="[(4, ref('group_subscription_user'))]"/>
        <!-- grant to admin/root so menus gated by these groups are visible on a fresh install -->
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access to subscriptions, plans and configuration.</field>
    </record>
</odoo>
