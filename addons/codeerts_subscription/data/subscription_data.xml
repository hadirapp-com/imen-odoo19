<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="subscription_plan_monthly" model="codeerts.subscription.plan">
            <field name="name">Monthly</field>
            <field name="billing_period_value">1</field>
            <field name="billing_period_unit">month</field>
            <field name="sequence">10</field>
        </record>
        <record id="subscription_plan_yearly" model="codeerts.subscription.plan">
            <field name="name">Yearly</field>
            <field name="billing_period_value">1</field>
            <field name="billing_period_unit">year</field>
            <field name="sequence">20</field>
        </record>

        <!-- Close reasons -->
        <record id="close_reason_end_of_contract" model="codeerts.subscription.close.reason">
            <field name="name">End of Contract</field>
            <field name="sequence">1</field>
            <field name="is_protected">True</field>
        </record>
        <record id="close_reason_too_expensive" model="codeerts.subscription.close.reason">
            <field name="name">Too Expensive</field>
            <field name="sequence">10</field>
        </record>
        <record id="close_reason_switched" model="codeerts.subscription.close.reason">
            <field name="name">Switched Provider</field>
            <field name="sequence">20</field>
        </record>
        <record id="close_reason_not_needed" model="codeerts.subscription.close.reason">
            <field name="name">No Longer Needed</field>
            <field name="sequence">30</field>
        </record>
        <record id="close_reason_payment_failed" model="codeerts.subscription.close.reason">
            <field name="name">Payment Failed</field>
            <field name="sequence">2</field>
            <field name="is_protected">True</field>
        </record>
        <record id="close_reason_other" model="codeerts.subscription.close.reason">
            <field name="name">Other</field>
            <field name="sequence">99</field>
        </record>
    </data>
</odoo>
