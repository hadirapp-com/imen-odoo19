<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_close_reason_list" model="ir.ui.view">
        <field name="name">codeerts.subscription.close.reason.list</field>
        <field name="model">codeerts.subscription.close.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_protected" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="action_subscription_close_reason" model="ir.actions.act_window">
        <field name="name">Close Reasons</field>
        <field name="res_model">codeerts.subscription.close.reason</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
