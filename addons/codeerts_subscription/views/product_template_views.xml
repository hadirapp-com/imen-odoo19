<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_subscription" model="ir.ui.view">
        <field name="name">product.template.form.subscription</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Add a labelled toggle next to Sales / Point of Sale / Purchase.
                 Each toggle in this strip is its own <span> with a <field> + <label for>;
                 the label is what renders the text, so we supply our own span+label. -->
            <span name="sale_option" position="after">
                <span class="d-inline-flex">
                    <field name="recurring_invoice"/>
                    <label for="recurring_invoice" string="Subscription"/>
                </span>
            </span>
        </field>
    </record>
</odoo>
