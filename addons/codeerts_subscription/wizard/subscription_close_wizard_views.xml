<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_close_wizard_form" model="ir.ui.view">
        <field name="name">codeerts.subscription.close.wizard.form</field>
        <field name="model">codeerts.subscription.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Close Subscription">
                <group>
                    <field name="order_id" invisible="1"/>
                    <field name="next_invoice_date" invisible="1"/>
                    <field name="close_reason_id" options="{'no_create': True}"/>
                    <field name="closing_mode" widget="radio"/>
                </group>
                <footer>
                    <button string="Close Subscription" name="action_close" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
