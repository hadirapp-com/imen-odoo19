<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_had_budget_form" model="ir.ui.view">
        <field name="name">account.budget.form</field>
        <field name="model">account.budget</field>
        <field name="arch" type="xml">
            <form string="Budget">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Done"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Budget Marketing 2026"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Budget Lines" name="lines">
                            <field name="line_ids">
                                <list string="Lines" editable="bottom">
                                    <field name="analytic_account_id"/>
                                    <field name="planned_amount" sum="Total Planned"/>
                                    <field name="achieved_amount" sum="Total Achieved"/>
                                    <field name="achieved_percentage" widget="progressbar"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="planned_amount" widget="monetary"/>
                                <field name="achieved_amount" widget="monetary"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_had_budget_list" model="ir.ui.view">
        <field name="name">account.budget.list</field>
        <field name="model">account.budget</field>
        <field name="arch" type="xml">
            <list string="Budgets" decoration-info="state == 'draft'"
                  decoration-success="state in ('confirmed', 'done')"
                  decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="planned_amount" sum="Total"/>
                <field name="achieved_amount" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state in ('confirmed', 'done')"
                       decoration-muted="state == 'cancel'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_had_budget_search" model="ir.ui.view">
        <field name="name">account.budget.search</field>
        <field name="model">account.budget</field>
        <field name="arch" type="xml">
            <search string="Budgets">
                <field name="name"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Start Month" name="group_date" context="{'group_by': 'date_from:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_had_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">account.budget</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first budget</p>
            <p>Track planned vs achieved amounts per analytic account.</p>
        </field>
    </record>
</odoo>
