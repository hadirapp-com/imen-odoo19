<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_hadir_asset_depreciation" model="ir.cron">
            <field name="name">Hadir Accounting: Post Asset Depreciation</field>
            <field name="model_id" ref="model_account_asset"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_entries()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=0, minute=30) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

        <record id="ir_cron_hadir_followup" model="ir.cron">
            <field name="name">Hadir Accounting: Process Customer Follow-ups</field>
            <field name="model_id" ref="model_hadir_followup_level"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_followups()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=6, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>
