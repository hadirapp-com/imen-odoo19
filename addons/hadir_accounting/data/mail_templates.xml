<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_hadir_followup_default" model="mail.template">
            <field name="name">Hadir Accounting: Follow-up Reminder</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Pengingat Pembayaran — {{ object.display_name }}</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.id }}</field>
            <field name="lang">{{ object.lang or 'id_ID' }}</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p>Halo <t t-out="object.name or ''">Pelanggan</t>,</p>
    <p>Berdasarkan catatan kami, terdapat tagihan Anda yang telah melewati jatuh tempo:</p>
    <t t-out="object.hadir_get_overdue_lines_html()"/>
    <p>Mohon segera lakukan pembayaran. Jika Anda sudah melakukan pembayaran, abaikan email ini atau hubungi kami beserta bukti pembayaran.</p>
    <p>Terima kasih atas perhatian Anda.</p>
    <p>
        Hormat kami,<br/>
        <t t-out="object.company_id.name or ''">Perusahaan</t>
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
