<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ==================== Templates ==================== -->
        <record id="view_umrah_notification_template_list" model="ir.ui.view">
            <field name="name">umrah.notification.template.list</field>
            <field name="model">umrah.notification.template</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="event_type"/>
                    <field name="active" widget="boolean_toggle"/>
                    <field name="company_id" groups="base.group_multi_company" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_umrah_notification_template_form" model="ir.ui.view">
            <field name="name">umrah.notification.template.form</field>
            <field name="model">umrah.notification.template</field>
            <field name="arch" type="xml">
                <form string="Notification Template">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg="bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group name="main">
                                <field name="event_type"/>
                                <field name="active" invisible="1"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <group string="Message Body">
                            <field name="body" nolabel="1" colspan="2"
                                   placeholder="Assalamu'alaikum ${object.full_name}, ..."/>
                        </group>
                        <div class="text-muted">
                            Placeholders use the mail.template syntax: ${object.full_name},
                            ${object.booking_id.name}, ${object.booking_id.departure_date},
                            ${object.state_label}, ${object.time_label}, ... The "object"
                            depends on the event (see the field help).
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_umrah_notification_template" model="ir.actions.act_window">
            <field name="name">Notification Templates</field>
            <field name="res_model">umrah.notification.template</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No notification templates yet
                </p>
                <p>
                    Default templates for every event are created at installation
                    and can be adapted to your wording.
                </p>
            </field>
        </record>

        <!-- ==================== Queue ==================== -->
        <record id="view_umrah_notification_list" model="ir.ui.view">
            <field name="name">umrah.notification.list</field>
            <field name="model">umrah.notification</field>
            <field name="arch" type="xml">
                <list decoration-muted="state in ('sent', 'cancelled')"
                      decoration-danger="state == 'failed'">
                    <field name="name"/>
                    <field name="event_type" optional="hide"/>
                    <field name="booking_id"/>
                    <field name="pilgrim_id" optional="show"/>
                    <field name="partner_id" optional="hide"/>
                    <field name="phone"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'queued'"
                           decoration-success="state == 'sent'"
                           decoration-danger="state == 'failed'"/>
                    <field name="provider" optional="hide"/>
                    <field name="sent_date" optional="show"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_umrah_notification_form" model="ir.ui.view">
            <field name="name">umrah.notification.form</field>
            <field name="model">umrah.notification</field>
            <field name="arch" type="xml">
                <form string="Notification">
                    <header>
                        <button name="action_send" type="object" string="Send Now"
                                class="oe_highlight" invisible="state != 'queued'"/>
                        <button name="action_queue_now" type="object" string="Re-queue"
                                invisible="state not in ('failed', 'cancelled')"/>
                        <button name="action_cancel" type="object" string="Cancel"
                                invisible="state != 'queued'" confirm="Cancel this notification?"/>
                        <field name="state" widget="statusbar" statusbar_visible="queued,sent"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group name="main">
                                <field name="event_type" readonly="state != 'queued'"/>
                                <field name="template_id" readonly="state != 'queued'"/>
                                <field name="booking_id" readonly="1"/>
                                <field name="pilgrim_id" readonly="1"/>
                                <field name="manasik_id" readonly="1" invisible="not manasik_id"/>
                                <field name="visa_id" readonly="1" invisible="not visa_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group name="delivery">
                                <field name="partner_id" readonly="1"/>
                                <field name="phone" readonly="state == 'sent'"/>
                                <field name="provider" readonly="1"/>
                                <field name="provider_message_id" readonly="1"/>
                                <field name="sent_date" readonly="1"/>
                                <field name="error_message" readonly="1" invisible="not error_message"/>
                            </group>
                        </group>
                        <group string="Message">
                            <field name="body" nolabel="1" colspan="2" readonly="state == 'sent'"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_umrah_notification_search" model="ir.ui.view">
            <field name="name">umrah.notification.search</field>
            <field name="model">umrah.notification</field>
            <field name="arch" type="xml">
                <search>
                    <field name="booking_id"/>
                    <field name="pilgrim_id"/>
                    <field name="partner_id"/>
                    <field name="phone"/>
                    <filter name="state_queued" string="Queued" domain="[('state', '=', 'queued')]"/>
                    <filter name="state_failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                    <filter name="state_sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                    <group>
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_event" string="Event" context="{'group_by': 'event_type'}"/>
                        <filter name="group_booking" string="Booking" context="{'group_by': 'booking_id'}"/>
                        <filter name="group_sent_day" string="Sent Date" context="{'group_by': 'sent_date:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_umrah_notification" model="ir.actions.act_window">
            <field name="name">Notifications</field>
            <field name="res_model">umrah.notification</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_umrah_notification_search"/>
            <field name="context">{'search_default_state_queued': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    The notification queue is empty
                </p>
                <p>
                    Notifications are queued daily by the scheduled actions
                    (document, payment, manasik and departure reminders) and when
                    a visa is approved. The queue is sent automatically.
                </p>
            </field>
        </record>

    </data>
</odoo>
