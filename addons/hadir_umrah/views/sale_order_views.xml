<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_form_umrah" model="ir.ui.view">
            <field name="name">sale.order.form.umrah</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_create_umrah_booking" type="object"
                            string="Create Umrah Booking" class="btn-primary"
                            groups="hadir_umrah.group_umrah_user"
                            invisible="state not in ('sale', 'done')"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_umrah_bookings" type="object"
                            class="oe_stat_button" icon="fa-plane"
                            groups="hadir_umrah.group_umrah_user"
                            invisible="umrah_booking_count == 0">
                        <field name="umrah_booking_count" widget="statinfo" string="Umrah Bookings"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
