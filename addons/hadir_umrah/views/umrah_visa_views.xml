<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List -->
        <record id="view_umrah_visa_list" model="ir.ui.view">
            <field name="name">umrah.visa.list</field>
            <field name="model">umrah.visa</field>
            <field name="arch" type="xml">
                <list decoration-muted="state in ('expired', 'rejected')">
                    <field name="visa_number"/>
                    <field name="pilgrim_id"/>
                    <field name="booking_id"/>
                    <field name="passport_number"
                           groups="hadir_umrah.group_umrah_user,hadir_umrah.group_umrah_visa"/>
                    <field name="submission_date" optional="show"/>
                    <field name="approval_date" optional="show"/>
                    <field name="expiry_date" optional="show"/>
                    <field name="state" widget="badge"
                           decoration-info="state in ('draft', 'submitted', 'processing')"
                           decoration-success="state == 'approved'"
                           decoration-danger="state in ('rejected', 'expired')"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- Form -->
        <record id="view_umrah_visa_form" model="ir.ui.view">
            <field name="name">umrah.visa.form</field>
            <field name="model">umrah.visa</field>
            <field name="arch" type="xml">
                <form string="Visa">
                    <header>
                        <button name="action_submit" type="object" string="Submit"
                                class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_process" type="object" string="Start Processing"
                                class="oe_highlight" invisible="state != 'submitted'"/>
                        <button name="action_approve" type="object" string="Approve"
                                class="oe_highlight" invisible="state not in ('submitted', 'processing')"/>
                        <button name="action_reject" type="object" string="Reject"
                                invisible="state not in ('submitted', 'processing')"/>
                        <button name="action_reset" type="object" string="Reset to Draft"
                                invisible="state not in ('rejected', 'expired')"/>
                        <button name="action_notify_pilgrim" type="object" string="Notify Pilgrim"
                                icon="fa-whatsapp"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,submitted,processing,approved"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="visa_number" placeholder="Visa number..."/></h1>
                        </div>
                        <group>
                            <group name="main">
                                <field name="booking_id"
                                       readonly="state not in ('draft')"
                                       options="{'no_create': True}"/>
                                <field name="pilgrim_id"
                                       readonly="state not in ('draft')"
                                       domain="[('booking_id', '=', booking_id)]"
                                       options="{'no_create': True}"/>
                                <field name="passport_number"
                                       groups="hadir_umrah.group_umrah_user,hadir_umrah.group_umrah_visa"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group name="dates">
                                <field name="application_date" readonly="state not in ('draft')"/>
                                <field name="submission_date"/>
                                <field name="approval_date"/>
                                <field name="expiry_date"/>
                            </group>
                        </group>
                        <group string="Attachments">
                            <field name="attachment_ids" nolabel="1" colspan="2"/>
                        </group>
                        <group string="Notes">
                            <field name="notes" nolabel="1" colspan="2"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Search -->
        <record id="view_umrah_visa_search" model="ir.ui.view">
            <field name="name">umrah.visa.search</field>
            <field name="model">umrah.visa</field>
            <field name="arch" type="xml">
                <search>
                    <field name="visa_number"/>
                    <field name="pilgrim_id"/>
                    <field name="passport_number"/>
                    <field name="booking_id"/>
                    <filter name="to_process" string="To Process"
                            domain="[('state', 'in', ('draft', 'submitted', 'processing'))]"/>
                    <filter name="state_processing" string="Processing" domain="[('state', '=', 'processing')]"/>
                    <filter name="state_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                    <filter name="state_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                    <group>
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_booking" string="Booking" context="{'group_by': 'booking_id'}"/>
                        <filter name="group_submission_month" string="Submission Month"
                                context="{'group_by': 'submission_date:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Actions -->
        <record id="action_umrah_visa" model="ir.actions.act_window">
            <field name="name">Visas</field>
            <field name="res_model">umrah.visa</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_umrah_visa_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No visa applications yet
                </p>
                <p>
                    Use "Generate Visas" on a booking in visa processing, or create
                    applications manually per pilgrim.
                </p>
            </field>
        </record>

    </data>
</odoo>
