<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Umrah Document -->
        <record id="view_umrah_document_list" model="ir.ui.view">
            <field name="name">umrah.document.list</field>
            <field name="model">umrah.document</field>
            <field name="arch" type="xml">
                <list decoration-muted="state in ('not_required',)">
                    <field name="pilgrim_id"/>
                    <field name="document_type_id"/>
                    <field name="booking_id" optional="show"/>
                    <field name="required" widget="boolean_toggle" optional="show"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'verified'"
                           decoration-info="state in ('submitted', 'verification')"
                           decoration-warning="state == 'rejected'"
                           decoration-danger="state in ('missing', 'expired')"/>
                    <field name="submitted_date" optional="show"/>
                    <field name="verified_date" optional="show"/>
                    <field name="expiry_date" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_umrah_document_form" model="ir.ui.view">
            <field name="name">umrah.document.form</field>
            <field name="model">umrah.document</field>
            <field name="arch" type="xml">
                <form string="Pilgrim Document">
                    <header>
                        <button name="action_submit" type="object" string="Submit"
                                class="oe_highlight" invisible="state not in ('missing', 'rejected')"/>
                        <button name="action_send_verification" type="object" string="Send to Verification"
                                invisible="state != 'submitted'"/>
                        <button name="action_verify" type="object" string="Verify"
                                class="oe_highlight" invisible="state not in ('submitted', 'verification')"/>
                        <button name="action_reject" type="object" string="Reject"
                                invisible="state not in ('submitted', 'verification')"/>
                        <button name="action_mark_not_required" type="object" string="Not Required"
                                invisible="state == 'not_required'"/>
                        <button name="action_reset" type="object" string="Reset"
                                invisible="state == 'missing'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="missing,submitted,verification,verified"/>
                    </header>
                    <sheet>
                        <group>
                            <group name="main">
                                <field name="pilgrim_id"/>
                                <field name="booking_id" invisible="1"/>
                                <field name="document_type_id"/>
                                <field name="required" widget="boolean_toggle"/>
                                <field name="expiry_date"/>
                            </group>
                            <group name="dates">
                                <field name="submitted_date"/>
                                <field name="verified_date"/>
                                <field name="verified_by" widget="many2one_avatar_user"/>
                            </group>
                        </group>
                        <group>
                            <field name="reject_reason" invisible="state != 'rejected'"/>
                        </group>
                        <notebook>
                            <page name="attachments" string="Attachments">
                                <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_umrah_document_search" model="ir.ui.view">
            <field name="name">umrah.document.search</field>
            <field name="model">umrah.document</field>
            <field name="arch" type="xml">
                <search>
                    <field name="pilgrim_id"/>
                    <field name="booking_id"/>
                    <field name="document_type_id"/>
                    <filter name="state_missing" string="Missing" domain="[('state', '=', 'missing')]"/>
                    <filter name="state_verification" string="In Verification"
                            domain="[('state', 'in', ('submitted', 'verification'))]"/>
                    <filter name="state_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                    <filter name="state_expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                    <group>
                        <filter name="group_pilgrim" string="Pilgrim" context="{'group_by': 'pilgrim_id'}"/>
                        <filter name="group_type" string="Document Type" context="{'group_by': 'document_type_id'}"/>
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_booking" string="Booking" context="{'group_by': 'booking_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_umrah_document" model="ir.actions.act_window">
            <field name="name">Documents</field>
            <field name="res_model">umrah.document</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_umrah_document_search"/>
        </record>

        <!-- Document Type -->
        <record id="view_umrah_document_type_list" model="ir.ui.view">
            <field name="name">umrah.document.type.list</field>
            <field name="model">umrah.document.type</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="has_expiry" widget="boolean_toggle"/>
                    <field name="active" widget="boolean_toggle" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_umrah_document_type_form" model="ir.ui.view">
            <field name="name">umrah.document.type.form</field>
            <field name="model">umrah.document.type</field>
            <field name="arch" type="xml">
                <form string="Document Type">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg="bg-danger" invisible="active"/>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                            </group>
                            <group>
                                <field name="sequence"/>
                                <field name="has_expiry"/>
                                <field name="active" invisible="1"/>
                            </group>
                        </group>
                        <field name="description" placeholder="Description..."/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_umrah_document_type" model="ir.actions.act_window">
            <field name="name">Document Types</field>
            <field name="res_model">umrah.document.type</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Document Template -->
        <record id="view_umrah_document_template_list" model="ir.ui.view">
            <field name="name">umrah.document.template.list</field>
            <field name="model">umrah.document.template</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="is_default" widget="boolean_toggle"/>
                    <field name="company_id" groups="base.group_multi_company" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_umrah_document_template_form" model="ir.ui.view">
            <field name="name">umrah.document.template.form</field>
            <field name="model">umrah.document.template</field>
            <field name="arch" type="xml">
                <form string="Document Template">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Template name..."/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="is_default"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="document_type_id"/>
                                <field name="required" widget="boolean_toggle"/>
                                <field name="note" optional="show"/>
                            </list>
                        </field>
                        <field name="note" placeholder="Notes..."/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_umrah_document_template" model="ir.actions.act_window">
            <field name="name">Document Templates</field>
            <field name="res_model">umrah.document.template</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a document requirement template
                </p>
                <p>
                    Assign a template to an Umrah package; the checklist is generated per
                    pilgrim when a booking is created.
                </p>
            </field>
        </record>

    </data>
</odoo>
