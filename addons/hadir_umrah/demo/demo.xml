<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Customer -->
        <record id="demo_partner_customer" model="res.partner">
            <field name="name">Keluarga Ahmad Fauzi</field>
            <field name="customer_rank">1</field>
            <field name="phone">+62 811 100 2000</field>
            <field name="email">ahmad.fauzi@example.com</field>
        </record>

        <!-- Packages -->
        <record id="demo_product_a" model="product.template">
            <field name="name">Paket Umroh A (9 Days)</field>
            <field name="type">service</field>
            <field name="invoice_policy">order</field>
            <field name="list_price">35000000</field>
            <field name="is_umrah_package">True</field>
            <field name="document_template_id" ref="umrah_document_template_a"/>
        </record>
        <record id="demo_product_a_pp" model="product.product">
            <field name="product_tmpl_id" ref="demo_product_a"/>
        </record>

        <record id="demo_product_b" model="product.template">
            <field name="name">Paket Umroh B (12 Days, Family)</field>
            <field name="type">service</field>
            <field name="invoice_policy">order</field>
            <field name="list_price">42000000</field>
            <field name="is_umrah_package">True</field>
            <field name="document_template_id" ref="umrah_document_template_b"/>
        </record>
        <record id="demo_product_b_pp" model="product.product">
            <field name="product_tmpl_id" ref="demo_product_b"/>
        </record>

        <!-- Sales Order: 3 pax of Paket Umroh A -->
        <record id="demo_sale_order" model="sale.order">
            <field name="partner_id" ref="demo_partner_customer"/>
        </record>
        <record id="demo_so_line" model="sale.order.line">
            <field name="order_id" ref="demo_sale_order"/>
            <field name="product_id" ref="demo_product_a_pp"/>
            <field name="product_uom_qty">3</field>
        </record>
        <function model="sale.order" name="action_confirm" eval="[[ref('demo_sale_order')]]"/>

        <!-- Booking + 3 pilgrims, departure 15 January 2027 -->
        <record id="demo_booking" model="umrah.booking">
            <field name="partner_id" ref="demo_partner_customer"/>
            <field name="sale_order_id" ref="demo_sale_order"/>
            <field name="product_id" ref="demo_product_a"/>
            <field name="departure_date">2027-01-15</field>
            <field name="return_date">2027-01-24</field>
        </record>

        <record id="demo_pilgrim_1" model="umrah.pilgrim">
            <field name="booking_id" ref="demo_booking"/>
            <field name="full_name">Ahmad Fauzi</field>
            <field name="gender">male</field>
            <field name="birth_place">Jakarta</field>
            <field name="birth_date">1980-04-12</field>
            <field name="nik">3174011204800001</field>
            <field name="phone">+62 811 100 2000</field>
            <field name="email">ahmad.fauzi@example.com</field>
            <field name="passport_number">X1234567</field>
            <field name="passport_issue_date">2021-06-01</field>
            <field name="passport_expiry_date">2031-05-31</field>
        </record>

        <record id="demo_pilgrim_2" model="umrah.pilgrim">
            <field name="booking_id" ref="demo_booking"/>
            <field name="full_name">Siti Rahmawati</field>
            <field name="gender">female</field>
            <field name="birth_place">Bandung</field>
            <field name="birth_date">1983-09-25</field>
            <field name="nik">3273012509830002</field>
            <field name="phone">+62 811 100 2001</field>
            <field name="passport_number">X2233445</field>
            <field name="passport_issue_date">2019-03-15</field>
            <field name="passport_expiry_date">2029-03-14</field>
        </record>

        <record id="demo_pilgrim_3" model="umrah.pilgrim">
            <field name="booking_id" ref="demo_booking"/>
            <field name="full_name">Budi Santoso</field>
            <field name="gender">male</field>
            <field name="birth_place">Surabaya</field>
            <field name="birth_date">1975-01-30</field>
            <field name="nik">3578013001750003</field>
            <field name="phone">+62 811 100 2002</field>
            <field name="passport_number">X9988776</field>
            <field name="passport_issue_date">2026-02-01</field>
            <field name="passport_expiry_date">2027-07-20</field>
        </record>

        <!-- Generate the document checklist from the package template -->
        <function model="umrah.booking" name="action_generate_checklist" eval="[[ref('demo_booking')]]"/>

        <!-- Operational tasks from the task catalog (auto-creates the project) -->
        <function model="umrah.booking" name="action_generate_tasks" eval="[[ref('demo_booking')]]"/>

        <!-- Visas: two approved, one pending -->
        <record id="demo_visa_1" model="umrah.visa">
            <field name="booking_id" ref="demo_booking"/>
            <field name="pilgrim_id" ref="demo_pilgrim_1"/>
            <field name="passport_number">X1234567</field>
            <field name="visa_number">VZ-2026-000101</field>
            <field name="application_date">2026-11-02</field>
            <field name="submission_date">2026-11-05</field>
            <field name="approval_date">2026-11-20</field>
            <field name="expiry_date">2027-02-15</field>
            <field name="state">approved</field>
        </record>
        <record id="demo_visa_2" model="umrah.visa">
            <field name="booking_id" ref="demo_booking"/>
            <field name="pilgrim_id" ref="demo_pilgrim_2"/>
            <field name="passport_number">X2233445</field>
            <field name="visa_number">VZ-2026-000102</field>
            <field name="application_date">2026-11-02</field>
            <field name="submission_date">2026-11-05</field>
            <field name="approval_date">2026-11-21</field>
            <field name="expiry_date">2027-02-15</field>
            <field name="state">approved</field>
        </record>
        <record id="demo_visa_3" model="umrah.visa">
            <field name="booking_id" ref="demo_booking"/>
            <field name="pilgrim_id" ref="demo_pilgrim_3"/>
            <field name="passport_number">X9988776</field>
            <field name="application_date">2026-11-02</field>
            <field name="state">processing</field>
        </record>

        <!-- Manasik session with attendance -->
        <record id="demo_manasik" model="umrah.manasik">
            <field name="name">Manasik - UMR/2027/00001</field>
            <field name="booking_id" ref="demo_booking"/>
            <field name="date">2027-01-08</field>
            <field name="start_time">9.0</field>
            <field name="end_time">11.5</field>
            <field name="location">Aula HadirApp, Jakarta</field>
        </record>
        <function model="umrah.manasik" name="action_fill_attendees" eval="[[ref('demo_manasik')]]"/>

        <!-- Flights shown on the portal -->
        <record id="demo_flight_outbound" model="umrah.flight">
            <field name="booking_id" ref="demo_booking"/>
            <field name="flight_type">outbound</field>
            <field name="airline">Garuda Indonesia</field>
            <field name="flight_number">GA-680</field>
            <field name="departure_city">Jakarta</field>
            <field name="departure_airport">Soekarno-Hatta (CGK)</field>
            <field name="departure_datetime">2027-01-15 04:30:00</field>
            <field name="arrival_city">Jeddah</field>
            <field name="arrival_airport">King Abdulaziz (JED)</field>
            <field name="arrival_datetime">2027-01-15 09:10:00</field>
        </record>
        <record id="demo_flight_return" model="umrah.flight">
            <field name="booking_id" ref="demo_booking"/>
            <field name="flight_type">return</field>
            <field name="airline">Garuda Indonesia</field>
            <field name="flight_number">GA-681</field>
            <field name="departure_city">Jeddah</field>
            <field name="departure_airport">King Abdulaziz (JED)</field>
            <field name="departure_datetime">2027-01-24 11:00:00</field>
            <field name="arrival_city">Jakarta</field>
            <field name="arrival_airport">Soekarno-Hatta (CGK)</field>
            <field name="arrival_datetime">2027-01-25 00:30:00</field>
        </record>

        <record id="demo_booking" model="umrah.booking">
            <field name="meeting_point">Bandara Soekarno-Hatta, Terminal 3, Counter HadirApp - pukul 01:30 WIB</field>
        </record>

    </data>
</odoo>
